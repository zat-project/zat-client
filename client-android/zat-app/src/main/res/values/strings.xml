    <!-- P1.4 · First-run onboarding. Honest by rule (PRIVACY_MODEL §11): no "untraceable",
         "unblockable", or "anonymous". Every line is a plain, defensible statement. -->
    <string name="onboarding_title">Welcome to ZAT</string>
    <string name="onboarding_what">ZAT helps you reach the open internet when your network blocks it. Tap Connect and it finds a working route on its own.</string>

    <string name="onboarding_privacy_title">What ZAT does with your data</string>
    <!-- Each bullet is a property of the code, not a promise. -->
    <string name="onboarding_privacy_1">Your traffic is encrypted end-to-end. The bridges that carry it cannot read what you do.</string>
    <string name="onboarding_privacy_2">ZAT never records your IP address. There is no account and no sign-up.</string>
    <string name="onboarding_privacy_3">If a route stops working, ZAT quietly switches to another.</string>

    <!-- The honest-limits screen. This is the part most apps skip; it is the part that earns trust. -->
    <string name="onboarding_honesty_title">What ZAT does not promise</string>
    <string name="onboarding_honesty_body">No tool can make you invisible, and we won\'t pretend otherwise. A determined network operator may still detect that you are using a circumvention tool, or block a route. ZAT is built to make that difficult and to recover when it happens — not to guarantee it never will.</string>

    <string name="onboarding_continue">Get started</string>
    <string name="onboarding_learn_more">How it works</string>

    <!-- Shown on the main screen, small, always visible: sets the honest expectation without a wall of text. -->
    <string name="tagline">Reach the open internet. Encrypted, no account, no logs.</string>

    <!-- Invite-graph (P3.1): paste a received tier credential; create an invitation to share. -->
    <string name="invite_title">Invitations</string>
    <string name="invite_message">Have an invitation? Paste it here for faster, more reliable connections. You don\'t need one — ZAT works without it.</string>
